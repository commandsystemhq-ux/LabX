# Copy to .env.local for development; set the same names in Vercel > Settings > Environment Variables.
# Use ONLY the project URL and the publishable (anon) key. They are public by design;
# data is protected by Row Level Security (see supabase/schema.sql).
# NEVER put a service_role / secret key here: the app refuses to start the client with one.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
