# Copy to .env.local for development; set the same names in Vercel > Settings > Environment Variables.
# VITE_* variables are public by design and ship to the browser: ONLY the project URL and the
# publishable (anon) key belong there (data is protected by Row Level Security, see supabase/schema.sql).
# NEVER put a service_role / secret key in a VITE_* variable: the app refuses to start the client with one.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ---- SERVER-ONLY (set in Vercel / your host; never prefix with VITE_, never commit real values) ----
# Used by the AI tutor server functions. The service-role key bypasses RLS: keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SETTINGS_ENCRYPTION_KEY=BASE64-32-BYTE-KEY
# Optional extra lock: comma-separated Supabase user ids allowed to open /admin even with role=admin.
ADMIN_USER_IDS=
